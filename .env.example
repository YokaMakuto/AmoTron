# 1. Create an application at https://discord.com/developers/applications
# 2. Bot -> Reset Token -> copy it below (NEVER commit the real .env)
# 3. Enable "SERVER MEMBERS INTENT" under Bot -> Privileged Gateway Intents
DISCORD_TOKEN=
CLIENT_ID=
# Optional: dev guild for instant slash-command updates (empty = global deploy)
GUILD_ID=
DATABASE_URL="file:./dev.db"
LOG_LEVEL=info
